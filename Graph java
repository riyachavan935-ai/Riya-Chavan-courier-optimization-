package com.courier.algorithm;
import java.util.*;

public class Graph {
    private Map<String, List<Edge>> adjList;

    public Graph() {
        this.adjList = new HashMap<>();
    }

    public static class Edge {
        String destination;
        int weight;
        public Edge(String dest, int w) {
            this.destination = dest;
            this.weight = w;
        }
    }

    public void addCity(String city) {
        adjList.putIfAbsent(city, new ArrayList<>());
    }

    public void addRoute(String from, String to, int distance) {
        addCity(from);
        addCity(to);
        adjList.get(from).add(new Edge(to, distance));
        adjList.get(to).add(new Edge(from, distance)); // Undirected
    }

    public Map<String, List<Edge>> getAdjList() {
        return adjList;
    }

    public void displayGraph() {
        System.out.println("=== Courier Network Graph ===");
        for(String city : adjList.keySet()) {
            System.out.print(city + " -> ");
            for(Edge e : adjList.get(city)) {
                System.out.print(e.destination + "(" + e.weight + "km) ");
            }
            System.out.println();
        }
    }

    // Initialize Maharashtra Courier Network
    public static Graph initializeMaharashtraNetwork() {
        Graph g = new Graph();
        g.addRoute("Mumbai", "Pune", 150);
        g.addRoute("Mumbai", "Nashik", 180);
        g.addRoute("Mumbai", "Thane", 30);
        g.addRoute("Pune", "Nashik", 210);
        g.addRoute("Pune", "Satara", 120);
        g.addRoute("Pune", "Nagpur", 700);
        g.addRoute("Nashik", "Nagpur", 700);
        g.addRoute("Nashik", "Aurangabad", 200);
        g.addRoute("Nagpur", "Aurangabad", 400);
        g.addRoute("Mumbai", "Lonavala", 80);
        g.addRoute("Lonavala", "Pune", 70);
        return g;
    }
}
